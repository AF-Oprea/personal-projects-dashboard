#!/bin/sh
set -eu

expected_name='AF-Oprea'
expected_email='37816944+AF-Oprea@users.noreply.github.com'

author_name="${GIT_AUTHOR_NAME:-$(git config user.name || true)}"
author_email="${GIT_AUTHOR_EMAIL:-$(git config user.email || true)}"

if [ "$author_name" != "$expected_name" ] || [ "$author_email" != "$expected_email" ]; then
  printf '%s\n' "Commit rejected: use $expected_name <$expected_email>." >&2
  printf '%s\n' "Run: git config user.name '$expected_name' && git config user.email '$expected_email'" >&2
  exit 1
fi
