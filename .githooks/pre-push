#!/bin/sh
set -eu

expected_name='AF-Oprea'
expected_email='37816944+AF-Oprea@users.noreply.github.com'
zero='0000000000000000000000000000000000000000'
remote_name="${1:-origin}"
tab="$(printf '\t')"
expected_ident="$expected_name$tab$expected_email$tab$expected_name$tab$expected_email"

# stdin (pre-push protocol): <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  # Range for both checks: remote..local, or for a new remote ref only the commits
  # not already on this remote (the history already there is not re-checked).
  if [ "$remote_sha" = "$zero" ]; then
    set -- "$local_sha" --not "--remotes=$remote_name"
  else
    set -- "$remote_sha..$local_sha"
  fi

  if ! commits="$(git rev-list "$@")"; then
    printf '%s\n' "Push rejected: cannot list the commits pushed to $remote_ref." >&2
    exit 1
  fi
  # One list, one commit at a time, for both checks: no pipes that could hide a git failure.
  for c in $commits; do
    if ! ident="$(git log -1 --format='%an%x09%ae%x09%cn%x09%ce' "$c")"; then
      printf '%s\n' "Push rejected: cannot read commit $c." >&2
      exit 1
    fi
    if [ "$ident" != "$expected_ident" ]; then
      printf '%s\n' "Push rejected: every commit must use $expected_name <$expected_email>." >&2
      printf '%s\n' "Invalid commit: $c	$ident" >&2
      exit 1
    fi

    # No Co-authored-by lines on this public repo: any line starting with "Co-authored-by:" (any case).
    if ! msg="$(git log -1 --format=%B "$c")"; then
      printf '%s\n' "Push rejected: cannot read commit $c." >&2
      exit 1
    fi
    if lines="$(printf '%s\n' "$msg" | grep -iE '^[[:space:]]*co-authored-by[[:space:]]*:')"; then
      printf '%s\n' "Push rejected: commit $c ($local_ref) has a Co-authored-by line; not allowed on this public repo:" "$lines" >&2
      printf '%s\n' "Nothing was pushed. Reword the local commit to drop the line; never force-push." >&2
      exit 1
    fi
  done
done
